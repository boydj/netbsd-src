#!/bin/sh
#
# /etc/rc for the ESP32-S31 root file system.
#
# The root file system is read-only, straight from SPI flash; keep the
# writable bits on tmpfs.
#

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

stty status '^T'

echo "Starting NetBSD on the Espressif ESP32-S31"

mount -u -o ro / 2>/dev/null		# pick up the device name from fstab
mount -t tmpfs -o -s2M tmpfs /tmp
mount -t tmpfs -o -s1M tmpfs /var
mount -t tmpfs -o -s512k tmpfs /root
cp -p /etc/profile /root/.profile
mkdir -p /var/run /var/log /var/tmp /var/db
chmod 1777 /tmp /var/tmp
mount -t kernfs kernfs /kern
mount -t procfs procfs /proc
mount -t ptyfs ptyfs /dev/pts

hostname esp32s31
: > /var/run/utmpx
: > /var/log/wtmpx

dmesg > /var/run/dmesg.boot

# Terminals (/etc/ttys links here): a login on the console, and on the
# UART and the USB-Serial/JTAG port unless one of them is the console.
cons=$(sysctl -n kern.consdev 2>/dev/null)
{
	echo 'console	"/usr/libexec/getty std.115200"	vt100	on secure'
	for t in ttyEU0:espuart0 ttyUSJ0:espusj0; do
		tty=${t%:*} dev=${t#*:}
		[ "$tty" != "$cons" ] && grep -q "^\[.*\] $dev at" /var/run/dmesg.boot &&
		    echo "$tty	\"/usr/libexec/getty std.115200\"	vt100	on secure"
	done
} > /var/run/ttys

# Network: loopback, then DHCP on every Ethernet interface, including USB
# adapters plugged in later.  dhcpcd goes to the background at once, so a
# missing cable doesn't hold up the login prompt.
ifconfig lo0 inet 127.0.0.1 up
# No IPv4 duplicate address detection, as with Linux and lwIP: it costs
# seconds per address, and NAT gateways that answer ARP for every address
# (some emulators' user-mode networking) would make it drop the lease.
sysctl -qw net.inet.ip.dad_count=0
mkdir -p /var/db/dhcpcd /var/run/dhcpcd /var/spool/lock
# Wi-Fi: join the network in /etc/espwifi.conf (ssid="..." psk="..."), if
# there is one; otherwise see espwifictl(8).  The link comes up once
# associated, and dhcpcd takes it from there.
if [ -f /etc/espwifi.conf ] && ifconfig espwifi0 >/dev/null 2>&1; then
	(. /etc/espwifi.conf && ifconfig espwifi0 up &&
	    espwifictl join "$ssid" "${psk:--}")
fi
dhcpcd -q -b

echo
uname -a
echo
exit 0
