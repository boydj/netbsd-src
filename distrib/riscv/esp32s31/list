#	$NetBSD$
#
# Programs in the ESP32-S31 root file system.
#

SRCDIRS	bin sbin usr.bin usr.sbin libexec external/bsd/less/bin

PROG	bin/cat
PROG	bin/chmod
PROG	bin/cp
PROG	bin/date
PROG	bin/dd
PROG	bin/df
PROG	bin/echo
PROG	bin/ed
PROG	bin/expr
PROG	bin/hostname
PROG	bin/kill
PROG	bin/ln
PROG	bin/ls
PROG	bin/mkdir
PROG	bin/mv
PROG	bin/ps
PROG	bin/pwd
PROG	bin/rm
PROG	bin/rmdir
PROG	bin/sh
PROG	bin/sleep
PROG	bin/stty
PROG	bin/sync
PROG	bin/test	bin/[

PROG	sbin/dmesg
PROG	sbin/init
PROG	sbin/mknod
PROG	sbin/mount
PROG	sbin/mount_ffs
PROG	sbin/mount_kernfs
PROG	sbin/mount_procfs
PROG	sbin/mount_ptyfs
PROG	sbin/mount_tmpfs
PROG	sbin/reboot	sbin/halt sbin/poweroff
PROG	sbin/shutdown
PROG	sbin/sysctl
PROG	sbin/umount

PROG	usr/bin/basename	usr/bin/dirname
PROG	usr/bin/cmp
PROG	usr/bin/cut
PROG	usr/bin/du
PROG	usr/bin/env
PROG	usr/bin/find
PROG	usr/bin/grep	usr/bin/egrep usr/bin/fgrep
PROG	usr/bin/head
PROG	usr/bin/hexdump	usr/bin/od
PROG	usr/bin/jot
PROG	usr/bin/id	usr/bin/whoami usr/bin/groups
PROG	usr/bin/less	usr/bin/more
PROG	usr/bin/login
PROG	usr/bin/printf
PROG	usr/bin/sed
PROG	usr/bin/seq
PROG	usr/bin/sort
PROG	usr/bin/stat	usr/bin/readlink
PROG	usr/bin/tail
PROG	usr/bin/tee
PROG	usr/bin/time
PROG	usr/bin/touch
PROG	usr/bin/tr
PROG	usr/bin/tset	usr/bin/reset
PROG	usr/bin/uname
PROG	usr/bin/fptest
PROG	usr/bin/uniq
PROG	usr/bin/vi	usr/bin/ex usr/bin/view
PROG	usr/bin/vmstat
PROG	usr/bin/w	usr/bin/uptime
PROG	usr/bin/wc
PROG	usr/bin/xargs
PROG	usr/bin/awk

PROG	usr/sbin/chroot
PROG	usr/sbin/pwd_mkdb

PROG	usr/libexec/getty

SPECIAL	awk	srcdir	external/historical/nawk/bin
SPECIAL	vi	srcdir	external/bsd/nvi/usr.bin/nvi
SPECIAL	fptest	srcdir	distrib/riscv/esp32s31/fptest

LIBS	libhack.o -ledit -lutil -lcurses -lterminfo -lkvm -lcrypt -lm -lprop -lbz2 -lz

# init invokes the shell as -sh
ARGVLN	sh -sh

COPY	${NETBSDSRCDIR}/etc/group		etc/group
COPY	${CURDIR}/etc/master.passwd		etc/master.passwd 600
COPY	${CURDIR}/etc/rc			etc/rc 755
COPY	${CURDIR}/etc/ttys			etc/ttys
COPY	${CURDIR}/etc/gettytab			etc/gettytab
COPY	${CURDIR}/etc/motd			etc/motd
COPY	${CURDIR}/etc/profile			etc/profile
COPY	${CURDIR}/etc/profile			root/.profile
COPY	${CURDIR}/etc/fstab			etc/fstab

# password databases
CMD	${TOOL_PWD_MKDB} -d . -p etc/master.passwd
MTREE	./etc/passwd	type=file uname=root gname=wheel mode=0644
MTREE	./etc/pwd.db	type=file uname=root gname=wheel mode=0644
MTREE	./etc/spwd.db	type=file uname=root gname=wheel mode=0600
