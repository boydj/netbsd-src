SPECIAL	awk	srcdir	external/historical/nawk/bin
SPECIAL	vi	srcdir	external/bsd/nvi/usr.bin/nvi
SPECIAL	fptest	srcdir	distrib/riscv/esp32s31/fptest
SPECIAL	dhcpcd	srcdir	external/bsd/dhcpcd/sbin/dhcpcd
SPECIAL	ftp	srcdir	distrib/riscv/esp32s31/x_ftp
SPECIAL	ifconfig	srcdir	distrib/utils/x_ifconfig
SPECIAL	ping	srcdir	distrib/utils/x_ping
SPECIAL	ping6	srcdir	distrib/utils/x_ping6
SPECIAL	route	srcdir	distrib/utils/x_route

LIBS	libhack.o -ledit -lutil -lcurses -lterminfo -lkvm -lcrypt -lm -lprop -lbz2 -lz

# init invokes the shell as -sh
ARGVLN	sh -sh

COPY	${NETBSDSRCDIR}/etc/group		etc/group
COPY	${CURDIR}/etc/master.passwd		etc/master.passwd 600
COPY	${CURDIR}/etc/rc			etc/rc 755
COPY	${CURDIR}/etc/ttys			etc/ttys
COPY	${CURDIR}/etc/gettytab			etc/gettytab
COPY	${CURDIR}/etc/motd			etc/motd
COPY	${CURDIR}/etc/profile			etc/profile
COPY	${CURDIR}/etc/profile			root/.profile
COPY	${CURDIR}/etc/fstab			etc/fstab
COPY	${CURDIR}/etc/hosts			etc/hosts
COPY	${CURDIR}/etc/dhcpcd.conf		etc/dhcpcd.conf
COPY	${CURDIR}/etc/services		etc/services
COPY	${NETBSDSRCDIR}/etc/protocols		etc/protocols
COPY	${DESTDIR}/libexec/dhcpcd-run-hooks	libexec/dhcpcd-run-hooks 555
COPY	${DESTDIR}/libexec/dhcpcd-hooks/20-resolv.conf libexec/dhcpcd-hooks/20-resolv.conf
COPY	${DESTDIR}/libexec/dhcpcd-hooks/30-hostname libexec/dhcpcd-hooks/30-hostname

# The root is read-only: dhcpcd's resolv.conf lives on tmpfs
SYMLINK	/var/run/resolv.conf		etc/resolv.conf

# password databases
CMD	${TOOL_PWD_MKDB} -d . -p etc/master.passwd
MTREE	./etc/passwd	type=file uname=root gname=wheel mode=0644
MTREE	./etc/pwd.db	type=file uname=root gname=wheel mode=0644
MTREE	./etc/spwd.db	type=file uname=root gname=wheel mode=0600
