#	$NetBSD$
#
# Espressif RISC-V SoC support (ESP32-S31)
#

defflag	opt_soc.h			SOC_ESP32S31

file	arch/riscv/espressif/esp32s31_platform.c	soc_esp32s31

# CLIC (S-mode bank) and interrupt matrix
device	espclic
attach	espclic at fdt with esp_clic
device	espintmtx
attach	espintmtx at fdt with esp_intmtx
file	arch/riscv/espressif/esp_clic.c		esp_clic | esp_intmtx

# SYSTIMER
device	espsystimer
attach	espsystimer at fdt with esp_systimer
file	arch/riscv/espressif/esp_systimer.c	esp_systimer | soc_esp32s31

# UART
device	espuart: tty
attach	espuart at fdt with esp_uart
file	arch/riscv/espressif/esp_uart.c		esp_uart

# TRNG
device	esptrng
attach	esptrng at fdt with esp_trng
file	arch/riscv/espressif/esp_trng.c		esp_trng

# Root file system in SPI flash (XIP window), served by md(4)
device	espxiproot
attach	espxiproot at fdt with esp_xiproot
file	arch/riscv/espressif/esp_xiproot.c	esp_xiproot

# Writable partition of the SPI flash, as a disk
device	espnor: disk
attach	espnor at fdt with esp_spiflash
file	arch/riscv/espressif/esp_spiflash.c	esp_spiflash

# Clock gates and resets
device	espclkrst: fdt_clock, fdt_reset
attach	espclkrst at fdt with esp_clkrst
file	arch/riscv/espressif/esp_clkrst.c	esp_clkrst

# GPIO and pin multiplexing
device	espgpio: gpiobus, fdt_gpio, fdt_clock, fdt_pinctrl
attach	espgpio at fdt with esp_gpio
file	arch/riscv/espressif/esp_gpio.c		esp_gpio

# Ethernet (DesignWare GMAC 3.70a, dwc_gmac(4))
# USB-Serial/JTAG (CDC-ACM) console
device	espusj: tty
attach	espusj at fdt with esp_usj
file	arch/riscv/espressif/esp_usj.c		esp_usj

# USB 2.0 OTG-HS PHY
device	espusbphy: fdt_phy, fdt_clock
attach	espusbphy at fdt with esp_usbphy
file	arch/riscv/espressif/esp_usbphy.c	esp_usbphy

attach	awge at fdt with esp_gmac: fdt_clock, fdt_gpio, fdt_pinctrl, fdt_reset, dwc_gmac_fdt_subr
file	arch/riscv/espressif/esp_gmac.c		esp_gmac

# Radio co-processor: ESP-IDF's Wi-Fi and Bluetooth on hart 1
device	espcp { }
attach	espcp at fdt with esp_cp
file	arch/riscv/espressif/esp_cp.c		esp_cp

device	espwifi: ether, ifnet, arp
attach	espwifi at espcp
file	arch/riscv/espressif/esp_cpwifi.c	espwifi

device	espbt: btbus, bluetooth
attach	espbt at espcp
file	arch/riscv/espressif/esp_cpbt.c		espbt
