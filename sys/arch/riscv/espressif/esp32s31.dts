// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Espressif ESP32-S31 device tree for NetBSD.
 *
 * Compatible with the bindings used by Espressif's Linux BSP
 * (arch/riscv/boot/dts/espressif/esp32s31.dts on integration/v6.18-esp32s31),
 * so the same blob works for both.  U-Boot passes it to the kernel
 * ("booti 0x40400000 - 0x40200000"); flash it at raw offset 0x300000.
 */

/dts-v1/;

/ {
	compatible = "espressif,esp32s31";
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Espressif ESP32-S31";

	aliases {
		serial0 = &uart0;
		serial1 = &usb_jtag;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	xtal_clk: clock-xtal {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	mpll_clk: clock-mpll {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <500000000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <320000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			compatible = "riscv";
			riscv,isa = "rv32imafc_zicsr_zifencei";
			riscv,isa-base = "rv32i";
			/* single-precision FPU only: F, no D */
			riscv,isa-extensions = "i", "m", "a", "f", "c", "zicsr",
					       "zifencei";
			mmu-type = "riscv,sv32";
			clock-frequency = <320000000>;

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@50000000 {
		device_type = "memory";
		reg = <0x50000000 0x01000000>;	/* 16MiB PSRAM */
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* CLIC, supervisor-mode bank (ids 16-47 delegated by OpenSBI) */
		clic: interrupt-controller@10a00000 {
			compatible = "espressif,esp32s31-clic";
			reg = <0x10a00000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&cpu0_intc>;
		};

		/* interrupt matrix, core 0 view */
		intmtx: interrupt-controller@20585000 {
			compatible = "espressif,esp32s31-intmtx";
			reg = <0x20585000 0x800>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&clic>;
		};

		uart0: serial@2038a000 {
			compatible = "esp,esp32s3-uart";
			reg = <0x2038a000 0x100>;
			clocks = <&clkrst 13>;
			current-speed = <115200>;
			interrupt-parent = <&intmtx>;
			interrupts = <9 4>;		/* IRQ_TYPE_LEVEL_HIGH */
			status = "okay";
		};

		/*
		 * UART1-3 have no pins of their own: put them on free GPIOs
		 * with pinctrl ("espressif,pins"/"espressif,functions", see
		 * the gpio node) or at run time, e.g.
		 *	sysctl -w hw.espgpio0.pin10=uart1_txd
		 *	sysctl -w hw.espgpio0.pin11=uart1_rxd
		 */
		uart1: serial@2038b000 {
			compatible = "espressif,esp32s31-uart";
			reg = <0x2038b000 0x100>;
			clocks = <&clkrst 14>;
			resets = <&clkrst 6>;
			interrupt-parent = <&intmtx>;
			interrupts = <10 4>;
		};

		uart2: serial@2038c000 {
			compatible = "espressif,esp32s31-uart";
			reg = <0x2038c000 0x100>;
			clocks = <&clkrst 15>;
			resets = <&clkrst 7>;
			interrupt-parent = <&intmtx>;
			interrupts = <11 4>;
		};

		/* Main system watchdog of timer group 1 */
		watchdog@20581000 {
			compatible = "espressif,esp32s31-mwdt";
			reg = <0x20581000 0x100>;
			clocks = <&clkrst 31>;
		};

		/*
		 * The LP domain's RTC timer, for the time of day across
		 * resets (kept in LP_SYS STORE10-15), and what it takes to
		 * calibrate its slow clock (timer group 0).
		 */
		rtc@20800000 {
			compatible = "espressif,esp32s31-rtc-timer";
			reg = <0x20800000 0x100>, <0x20700054 0x18>,
			      <0x20701000 0x4>, <0x20580000 0x100>,
			      <0x20587114 0x8>;
		};

		/*
		 * I2C0/1 and GPSPI2/3, pins through the GPIO matrix too
		 * (i2cN_scl, i2cN_sda; spiN_sck, spiN_mosi, spiN_miso,
		 * spiN_cs0..).  I2C devices for kernel drivers go in here as
		 * child nodes, with a pinctrl-0 so that the pins are set up
		 * before they're probed.
		 */
		i2c0: i2c@20385000 {
			compatible = "espressif,esp32s31-i2c";
			reg = <0x20385000 0x200>;
			clocks = <&clkrst 17>;
			resets = <&clkrst 9>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c1: i2c@20386000 {
			compatible = "espressif,esp32s31-i2c";
			reg = <0x20386000 0x200>;
			clocks = <&clkrst 18>;
			resets = <&clkrst 10>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi2: spi@2038f000 {
			compatible = "espressif,esp32s31-spi";
			reg = <0x2038f000 0x1000>;
			clocks = <&clkrst 19>;
			resets = <&clkrst 11>;
			num-cs = <4>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		spi3: spi@20390000 {
			compatible = "espressif,esp32s31-spi";
			reg = <0x20390000 0x1000>;
			clocks = <&clkrst 20>;
			resets = <&clkrst 12>;
			num-cs = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		uart3: serial@2038d000 {
			compatible = "espressif,esp32s31-uart";
			reg = <0x2038d000 0x100>;
			clocks = <&clkrst 16>;
			resets = <&clkrst 8>;
			interrupt-parent = <&intmtx>;
			interrupts = <12 4>;
		};

		trng: rng@20814000 {
			compatible = "espressif,esp32s31-trng";
			reg = <0x20814000 0x100>, <0x2071003c 0x4>;
			reg-names = "trng", "clkrst";
		};

		/*
		 * Root file system at flash offset 0x900000, read through the
		 * XIP window (which maps flash 0x100000 and up at 0x40000000).
		 */
		rootfs: flash@40800000 {
			compatible = "espressif,esp32s31-xip-rootfs";
			reg = <0x40800000 0x00400000>;
		};

		/*
		 * The flash's writable partition, at 0x200000 (1 MB, between
		 * U-Boot and its device tree), through the MSPI controller's
		 * SPI1 port.  /etc/rc mounts it on /persist.
		 */
		spiflash: flash@20501000 {
			compatible = "espressif,esp32s31-spi-flash";
			reg = <0x20501000 0x1000>, <0x20500000 0x1000>;
			reg-names = "spi1", "spi0";
			espressif,partition = <0x00200000 0x00100000>;
		};

		/*
		 * Radio co-processor: ESP-IDF's Wi-Fi and Bluetooth stacks on
		 * hart 1.  The firmware is at flash offset 0xd00000 and runs in
		 * place; its RAM parts go above OpenSBI in the HP SRAM and in
		 * LP RAM.  FROM_CPU interrupt 1 rings it, 2 rings us.
		 */
		coproc: coprocessor@40c00000 {
			compatible = "espressif,esp32s31-coproc";
			reg = <0x40c00000 0x00300000>,
			      <0x2f030000 0x0004afc0>,
			      <0x2e000000 0x00008000>,
			      <0x20586010 0x00000010>;
			reg-names = "firmware", "sram", "lpram", "doorbell";
			interrupt-parent = <&intmtx>;
			interrupts = <67 4>;
		};

		/*
		 * Clock gates and resets in HP_SYS_CLKRST and CNNT_SYS; the
		 * cells are Espressif's dt-bindings ids.
		 */
		clkrst: clock-controller@20587000 {
			compatible = "espressif,esp32s31-clkrst";
			reg = <0x20587000 0x400>,	/* HP_SYS_CLKRST */
			      <0x20359000 0x100>,	/* CNNT_SYS */
			      <0x20586000 0x400>,	/* HP_SYSTEM */
			      <0x20710000 0x100>;	/* LP_PERI_CLKRST */
			clocks = <&xtal_clk>, <&mpll_clk>;
			clock-names = "xtal", "mpll";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		/* Connectivity system registers (EMAC/USB/SDIO glue) */
		cnnt_sys: syscon@20359000 {
			compatible = "espressif,esp32s31-cnnt-sys", "syscon";
			reg = <0x20359000 0x100>;
		};

		/* IO_MUX, GPIO + GPIO matrix, CNNT dedicated pads */
		gpio: pinctrl@20582000 {
			compatible = "espressif,esp32s31-gpio";
			reg = <0x20582000 0x100>, <0x20583000 0xe00>,
			      <0x20588000 0x400>;
			clocks = <&clkrst 0>, <&clkrst 1>;
			clock-names = "apb", "iomux";
			gpio-controller;
			#gpio-cells = <2>;
			/* flash/PSRAM, USB PHY, console */
			gpio-reserved-ranges = <26 7>, <33 2>, <58 2>;

			/* pinmux = <(pin << 16) | function> */
			emac_pins: emac-pins {
				pinmux = <0x050005>,	/* GPIO5  MDC */
					 <0x060006>,	/* GPIO6  MDIO */
					 <0x080004>,	/* GPIO8-12 TXD0-3, TX_CTL */
					 <0x090004>,
					 <0x0a0004>,
					 <0x0b0004>,
					 <0x0c0004>,
					 <0x0d0004>,	/* GPIO13 TX_CLK */
					 <0x0e0004>,	/* GPIO14-19 RX_CLK, RX_CTL, RXD3-0 */
					 <0x0f0004>,
					 <0x100004>,
					 <0x110004>,
					 <0x120004>,
					 <0x130004>;
				input-enable;
				bias-disable;
				drive-strength = <20>;
			};

			/* SD slot 0: function 7 is the dedicated SDIO path */
			sdmmc_pins: sdmmc-pins {
				pinmux = <0x140007>,	/* GPIO20-23 DAT0-3 */
					 <0x150007>,
					 <0x160007>,
					 <0x170007>,
					 <0x180007>,	/* GPIO24 CLK */
					 <0x190007>;	/* GPIO25 CMD */
				input-enable;
				bias-pull-up;
				drive-strength = <20>;
			};
		};

		/*
		 * Ethernet: DesignWare GMAC 3.70a, RGMII to a Motorcomm YT8531
		 * on Espressif's dev board.  DMA is not cache coherent.
		 */
		emac: ethernet@20350000 {
			compatible = "espressif,esp32s31-dwmac", "snps,dwmac-3.70a";
			reg = <0x20350000 0x2000>;
			interrupt-parent = <&intmtx>;
			interrupts = <98 4>;
			clocks = <&clkrst 6>, <&clkrst 7>, <&clkrst 10>;
			clock-names = "stmmaceth", "ref", "ptp_ref";
			resets = <&clkrst 3>;
			reset-names = "stmmaceth";
			espressif,cnnt-sys = <&cnnt_sys>;
			snps,force_thresh_dma_mode;
			snps,txpbl = <32>;
			snps,rxpbl = <8>;
			snps,no-pbl-x8;
			snps,mixed-burst;
			phy-mode = "rgmii-id";
			pinctrl-names = "default";
			pinctrl-0 = <&emac_pins>;
			max-speed = <100>;

			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;

				ethernet-phy@0 {
					reg = <0>;
					reset-gpios = <&gpio 7 1>;	/* active low */
					reset-assert-us = <10000>;
					reset-deassert-us = <500000>;
				};
			};
		};

		systimer: timer@20399000 {
			compatible = "espressif,esp32s31-systimer";
			reg = <0x20399000 0x100>;
			clock-frequency = <16000000>;
			interrupt-parent = <&intmtx>;
			interrupts = <33 4>;		/* IRQ_TYPE_LEVEL_HIGH */
			interrupt-names = "target0";
		};

		/*
		 * USB-Serial/JTAG: the CDC-ACM port on the board's "USB"
		 * connector.  Set stdout-path to "serial1" to make it the
		 * console.
		 */
		usb_jtag: serial@20391000 {
			compatible = "esp,esp32s31-usb-serial-jtag",
			    "esp,esp32s3-acm";
			reg = <0x20391000 0x1000>;
			interrupt-parent = <&intmtx>;
			interrupts = <2 4>;
		};

		/*
		 * SD/MMC host (DesignWare MSHC).  The dev board's microSD
		 * socket is on slot 0, the dedicated pads GPIO20-25, at
		 * 3.3V; there is no card-detect line.
		 */
		sdmmc: mmc@20342000 {
			compatible = "espressif,esp32s31-dw-mshc", "snps,dw-mshc";
			reg = <0x20342000 0x1000>;
			interrupt-parent = <&intmtx>;
			interrupts = <3 4>;
			clocks = <&clkrst 11>, <&clkrst 12>;
			clock-names = "biu", "ciu";
			resets = <&clkrst 5>;
			pinctrl-names = "default";
			pinctrl-0 = <&sdmmc_pins>;
			bus-width = <4>;
			max-frequency = <50000000>;
			cap-sd-highspeed;
			broken-cd;
		};

		/* HP_ALIVE_SYS: USB PHY power and line state, among others */
		hp_alive_sys: syscon@20589000 {
			compatible = "esp,esp32s31-hp-alive-sys", "syscon";
			reg = <0x20589000 0x100>;
		};

		usb_phy: usb-phy@20380000 {
			compatible = "esp,esp32s31-usb-phy";
			reg = <0x20380000 0x20>;
			#phy-cells = <0>;
			clocks = <&clkrst 9>;		/* USB_OTGHS_PHYREF */
			clock-names = "ref";
			esp,hp-alive-sys = <&hp_alive_sys>;
			esp,cnnt-sys = <&cnnt_sys>;
		};

		/* USB 2.0 OTG-HS: a DesignWare HS OTG controller, host mode */
		usb: usb@20300000 {
			compatible = "esp,esp32s31-hsotg", "snps,dwc2";
			reg = <0x20300000 0x40000>;
			interrupt-parent = <&intmtx>;
			interrupts = <99 4>;
			clocks = <&clkrst 8>;		/* USB_OTGHS_BUS */
			clock-names = "otg";
			resets = <&clkrst 4>;		/* USB_OTGHS */
			reset-names = "dwc2";
			phys = <&usb_phy>;
			phy-names = "usb2-phy";
			dr_mode = "host";
		};
	};
};
