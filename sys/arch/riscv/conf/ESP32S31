#	$NetBSD$
#
# Kernel for the Espressif ESP32-S31 (RV32IMAC + Sv32, 16MiB PSRAM).
#
# Boot chain: ROM -> U-Boot SPL -> OpenSBI -> U-Boot -> (esp32s31-loader)
# -> netbsd.  See sys/arch/riscv/espressif/README.esp32s31.
#

include	"arch/riscv/conf/std.riscv"
include	"arch/riscv/espressif/files.espressif"

ident		ESP32S31

maxusers	8

options 	SOC_ESP32S31
options 	RISCV_CLIC		# interrupts via the CLIC, no sie/sip
options 	FDT
options 	HZ=100

# The kernel is copied by esp32s31-loader to the start of PSRAM.  Kernel
# VA 0x80000000 maps PA 0x50000000; the 32MiB kernel window covers all of
# the PSRAM, which also serves as the direct map.
makeoptions	TEXTADDR=0x80000000
makeoptions	KERNEL_PHYS=0x50000000

# Size matters: keep this small.
makeoptions	COPTS="-Os -fno-omit-frame-pointer"
makeoptions	COPY_SYMTAB=1

options 	DIAGNOSTIC
options 	DDB			# in-kernel debugger
options 	DDB_ONPANIC=1
options 	DDB_HISTORY_SIZE=64
#options 	VERBOSE_INIT_RISCV

options 	MSGBUFSIZE=16384

# Standard system options
options 	INSECURE		# no securelevel restrictions
options 	USERCONF
options 	PIPE_SOCKETPAIR		# smaller, but slower pipe(2)

# File systems
file-system 	FFS		# UFS
file-system 	TMPFS		# Efficient memory file-system
file-system 	KERNFS		# /kern
file-system 	PROCFS		# /proc
file-system 	PTYFS		# /dev/pts/N support
options 	FFS_NO_SNAPSHOT

# Root on the embedded memory disk (filled in by mdsetimage)
pseudo-device	md
options 	MEMORY_DISK_HOOKS
options 	MEMORY_DISK_IS_ROOT
options 	MEMORY_DISK_SERVER=0
options 	MEMORY_DISK_ROOT_SIZE=6144	# 3MiB, in 512 byte blocks


config		netbsd	root on md0a type ffs

#
# Devices
#
mainbus0	at root
simplebus*	at fdt? pass 0

cpus*		at fdt? pass 0
cpu*		at fdt? pass 0

fclock*		at fdt? pass 1

espclic*	at fdt? pass 1		# CLIC, S-mode bank
espintmtx*	at fdt? pass 2		# interrupt matrix
espsystimer*	at fdt? pass 3		# SYSTIMER: timecounter and clock
espuart*	at fdt?			# UART
esptrng*	at fdt?			# true random number generator

pseudo-device	pty			# pseudo-terminals
pseudo-device	clockctl		# user control of clock subsystem
pseudo-device	ksyms			# /dev/ksyms
pseudo-device	drvctl

options 	PAX_MPROTECT=0
options 	PAX_ASLR=0
